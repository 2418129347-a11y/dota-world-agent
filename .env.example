# Delivery is disabled unless --send is provided locally or ENABLE_SEND=true in GitHub Actions.
MAIL_PROVIDER=smtp
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=your-account@qq.com
SMTP_PASSWORD=your-smtp-authorization-code
DIGEST_FROM=
DIGEST_TO=recipient@example.com

# Optional Resend alternative.
RESEND_API_KEY=

# Optional AI summarization. The deterministic fallback needs no key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano

ENABLE_SEND=false
